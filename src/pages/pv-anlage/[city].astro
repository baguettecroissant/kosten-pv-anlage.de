---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteWidget from '../../components/QuoteWidget.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { siteConfig } from '../../../site.config';
import { getAllCities, getNearbyCities, type City } from '../../lib/cities';
import { generateCityContent, computeNearbyCityComparisons } from '../../lib/city-content-engine';

export function getStaticPaths() {
  const cities = getAllCities();
  return cities.map(city => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as { city: City };
const content = generateCityContent(city);
const { metrics, landLinks, selectedFederalLinks } = content;

const nearbyCities = getNearbyCities(city, 8);
const nearbyComparisons = computeNearbyCityComparisons(city, nearbyCities);

// TapTapHome AVR Check
const isHighAvr = siteConfig.taptaphome.highAvrPrefixes.some(prefix => city.zip.startsWith(prefix));

// Seed-based dynamic pricing for price cards
const seed = city.slug.split('').reduce((acc: number, c: string) => acc + c.charCodeAt(0), 0);
let multiplier = 1.0;
if (city.region === 'south') multiplier = 1.05;
else if (city.region === 'north') multiplier = 0.95;
else if (city.region === 'east') multiplier = 0.90;

const pMin = Math.round((5500 + (seed % 1000)) * multiplier / 100) * 100;
const pMid = Math.round((9000 + (seed % 1500)) * multiplier / 100) * 100;
const pMax = Math.round((14000 + (seed % 2500)) * multiplier / 100) * 100;
const pSp = Math.round((18000 + (seed % 3000)) * multiplier / 100) * 100;

const title = siteConfig.niche.seoTitleTemplate.replace('{city}', city.name).replace('{zip}', city.zip);
const description = siteConfig.niche.metaDescTemplate.replace('{city}', city.name).replace('{zip}', city.zip).replace('{priceMin}', pMid.toLocaleString('de-DE')).replace('{priceMax}', pSp.toLocaleString('de-DE'));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Installation Solaranlage " + city.name,
    "description": description,
    "areaServed": { "@type": "City", "name": city.name, "postalCode": city.zip },
    "provider": { "@type": "Organization", "name": siteConfig.name },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.faq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://" + siteConfig.domain },
      { "@type": "ListItem", "position": 2, "name": "Städte", "item": "https://" + siteConfig.domain + "/pv-anlage" },
      { "@type": "ListItem", "position": 3, "name": city.name },
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={"/pv-anlage/" + city.slug} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="gradient-hero text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: "Städte", href: "/pv-anlage" },
        { label: city.bundesland, href: "/pv-anlage" },
        { label: city.name, href: "/pv-anlage/" + city.slug },
      ]} />

      <div class="grid lg:grid-cols-5 gap-10 items-start mt-6">
        <div class="lg:col-span-3">
          {isHighAvr && (
            <div class="inline-flex items-center gap-2 bg-amber-500/20 border border-amber-500/30 px-3 py-1.5 rounded-full text-xs text-amber-300 mb-4 sun-pulse font-semibold">
              ☀️ Top-PV-Region: Lokale Fachbetriebe aktiv
            </div>
          )}

          <h1 class="text-2xl md:text-4xl font-extrabold leading-tight mb-4 font-heading">
            Photovoltaik-Preise in {city.name} ({city.zip})
          </h1>
          <p class="text-blue-100 leading-relaxed mb-6 max-w-xl text-sm md:text-base">
            Kosten pro kWp, Wirtschaftlichkeitsanalyse und aktuelle Angebote für Ihre Solaranlage in {city.name} — Datenstand 2026.
          </p>

          <div class="flex flex-wrap gap-3 mb-6">
            <span class="bg-white/10 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs">📍 PLZ {city.zip}</span>
            <span class="bg-white/10 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs">☀️ {city.sonnenstunden} Sonnenstunden</span>
            <span class="bg-white/10 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs">⚡ {metrics.spezifischerErtrag} kWh/kWp</span>
            <span class="bg-white/10 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs">✓ 0% Umsatzsteuer</span>
          </div>

          <a href="#devis-form" class="inline-block cta-gradient text-white font-bold px-6 py-3.5 rounded-xl transition-all shadow-lg text-sm md:text-base">
            ☀️ Angebote in {city.name} vergleichen →
          </a>
        </div>

        <div class="lg:col-span-2">
          <QuoteWidget keyword={"Solaranlage " + city.name} />
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">

    <!-- Block 1: Local Intro (unique per city) -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-6">
      <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-2 font-heading">🏠 Photovoltaik in {city.name} — {metrics.cityCategoryLabel} mit {city.sonnenstunden} Sonnenstunden</h2>
      
      <div class="text-gray-700 space-y-4 leading-relaxed text-sm md:text-base">
        <p>{content.intro}</p>
        
        <h3 class="text-lg font-bold text-gray-900 pt-2 font-heading">💡 Regionaler Expertentipp für {city.name}</h3>
        <p set:html={content.localTip} />

        <h3 class="text-lg font-bold text-gray-900 pt-2 font-heading">📊 Solarmarkt & Installateure in {city.name}</h3>
        <p>{content.marketData}</p>

        <h3 class="text-lg font-bold text-gray-900 pt-2 font-heading">☀️ Sonnenpotenzial & Solarertrag am Standort {city.zip}</h3>
        <p>{content.sonnenpotenzial}</p>
      </div>
    </section>

    <!-- Block 2: Price Range -->
    <section class="bg-gradient-to-r from-blue-50 to-teal-50/30 rounded-2xl border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">💰 Kosten für Solaranlagen in {city.name} ({city.zip})</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
        <div class="bg-white rounded-xl p-4 text-center border border-gray-200">
          <span class="block text-xs text-gray-500 mb-1">Klein (4 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-gray-900 font-data">{pMin.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Ohne Speicher</span>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-teal-300 ring-2 ring-teal-100">
          <span class="block text-xs text-teal-700 font-semibold mb-1">Mittel (8 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-gray-900 font-data">{pMid.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Ohne Speicher</span>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-gray-200">
          <span class="block text-xs text-gray-500 mb-1">Groß (12 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-gray-900 font-data">{pMax.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Ohne Speicher</span>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-gray-200">
          <span class="block text-xs text-teal-700 font-semibold mb-1">PV + Speicher (10 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-teal-700 font-data">{pSp.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Inkl. 10 kWh Speicher</span>
        </div>
      </div>
      <p class="text-xs text-gray-500">
        * Richtwerte für Brutto-Komplettpreise in {city.name} im Jahr 2026 inkl. Montage, Netzanschluss und Anmeldung. 0% Umsatzsteuer auf Solaranlagen (§ 12 Abs. 3 UStG).
      </p>
    </section>

    <!-- Block 3: Wirtschaftlichkeitsanalyse (unique data per city) -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">📊 Wirtschaftlichkeitsanalyse für {city.name}</h2>
      <p class="text-sm text-gray-600 mb-4">Berechnet auf Basis der lokalen Einstrahlungsdaten, regionalen Strompreise in {city.bundesland} und aktuellen Modulpreise 2026.</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-gradient-to-br from-green-50 to-green-100/50 rounded-xl p-4 border border-green-200">
          <span class="block text-xs text-green-700 font-semibold mb-1">Jährliche Ersparnis</span>
          <span class="block text-lg font-bold text-green-800 font-data">{metrics.ersparnisProJahr.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-green-600">Mit 10 kWp + Speicher</span>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-indigo-100/50 rounded-xl p-4 border border-blue-200">
          <span class="block text-xs text-blue-700 font-semibold mb-1">Amortisation</span>
          <span class="block text-lg font-bold text-blue-800 font-data">{metrics.amortisationOhne} Jahre</span>
          <span class="block text-[10px] text-blue-600">Ohne Speicher</span>
        </div>
        <div class="bg-gradient-to-br from-amber-50 to-amber-100/50 rounded-xl p-4 border border-amber-200">
          <span class="block text-xs text-amber-700 font-semibold mb-1">Gesamtrendite</span>
          <span class="block text-lg font-bold text-amber-800 font-data">{metrics.renditeUeber25} %</span>
          <span class="block text-[10px] text-amber-600">Über 25 Jahre</span>
        </div>
        <div class="bg-gradient-to-br from-teal-50 to-teal-100/50 rounded-xl p-4 border border-teal-200">
          <span class="block text-xs text-teal-700 font-semibold mb-1">Cashflow 25 Jahre</span>
          <span class="block text-lg font-bold text-teal-800 font-data">{metrics.cashflow25Jahre.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-teal-600">Netto-Gewinn nach Investition</span>
        </div>
      </div>

      <!-- Detailed data table -->
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="text-left px-4 py-2.5 text-gray-600 font-semibold text-xs">Kennzahl</th>
              <th class="text-right px-4 py-2.5 text-gray-600 font-semibold text-xs">Wert für {city.name}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="px-4 py-2.5 text-gray-700">Globalstrahlung</td><td class="px-4 py-2.5 text-right font-data font-semibold text-gray-900">{metrics.globalstrahlung} kWh/m²/Jahr</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">Spezifischer Ertrag</td><td class="px-4 py-2.5 text-right font-data font-semibold text-gray-900">{metrics.spezifischerErtrag} kWh/kWp</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">Jahresertrag (10 kWp)</td><td class="px-4 py-2.5 text-right font-data font-semibold text-gray-900">{metrics.ertrag10kwp.toLocaleString('de-DE')} kWh</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">Eigenverbrauchsquote (mit Speicher)</td><td class="px-4 py-2.5 text-right font-data font-semibold text-green-700">{metrics.eigenverbrauchOptimal} %</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">Eigenverbrauchsquote (ohne Speicher)</td><td class="px-4 py-2.5 text-right font-data font-semibold text-gray-900">{metrics.eigenverbrauchOhne} %</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">Netzstrompreis {city.bundesland}</td><td class="px-4 py-2.5 text-right font-data font-semibold text-red-600">{metrics.strompreis.avg.toFixed(1)} ct/kWh</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">Solarstrom-Gestehungskosten</td><td class="px-4 py-2.5 text-right font-data font-semibold text-green-700">{metrics.solarstromkosten.toFixed(1)} ct/kWh</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">CO₂-Vermeidung pro Jahr</td><td class="px-4 py-2.5 text-right font-data font-semibold text-gray-900">{metrics.co2Ersparnis.toLocaleString('de-DE')} kg</td></tr>
            <tr><td class="px-4 py-2.5 text-gray-700">Netzbetreiber</td><td class="px-4 py-2.5 text-right"><a href={metrics.netzbetreiber.url} target="_blank" rel="noopener nofollow" class="text-accent-600 hover:text-accent-500 font-semibold underline">{metrics.netzbetreiber.name}</a></td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-[11px] text-gray-400 mt-3">Quelle: Eigene Berechnungen auf Basis von DWD-Globalstrahlungsdaten, BDEW-Strompreisanalyse und aktuellen Marktpreisen 2026. Richtwerte ohne Gewähr.</p>
    </section>

    <!-- Block 4: Strompreis-Vergleich -->
    <section class="info-card rounded-xl p-6">
      <h3 class="text-lg font-bold text-blue-900 mb-3 font-heading">⚡ Netzstrom vs. Solarstrom in {city.name}</h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl p-4 border border-red-100">
          <h4 class="font-bold text-red-700 text-sm mb-2">🔴 Strombezug vom Netz ({city.bundesland})</h4>
          <p class="font-data text-lg font-bold text-red-600">ca. {metrics.strompreis.min.toFixed(1)} – {metrics.strompreis.max.toFixed(1)} ct/kWh</p>
          <p class="text-xs text-gray-500">Ø {metrics.strompreis.avg.toFixed(1)} ct/kWh — steigende Tendenz</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-green-100">
          <h4 class="font-bold text-green-700 text-sm mb-2">🟢 Strom vom eigenen Dach</h4>
          <p class="font-data text-lg font-bold text-green-600">ca. {metrics.solarstromkosten.toFixed(1)} ct/kWh</p>
          <p class="text-xs text-gray-500">Garantiert stabil über 25+ Jahre</p>
        </div>
      </div>
      <p class="text-xs text-blue-900/80 mt-3 font-semibold">
        Ihre Netto-Ersparnis pro Kilowattstunde in {city.name}: {(metrics.strompreis.avg - metrics.solarstromkosten).toFixed(1)} Cent. Bei {metrics.ertrag10kwp.toLocaleString('de-DE')} kWh Jahresproduktion und {metrics.eigenverbrauchOptimal}% Eigenverbrauch sparen Sie {metrics.ersparnisProJahr.toLocaleString('de-DE')} € pro Jahr.
      </p>
    </section>

    <!-- Block 5: Map Section -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-4">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-1 font-heading">🗺️ Solarstandort-Karte: {city.name} & Umgebung</h2>
      <p class="text-sm text-gray-600">
        Interaktive Karte mit Solarpotenzial-Vergleich der Nachbarstädte. {city.name} ({city.zip}) erreicht {metrics.spezifischerErtrag} kWh/kWp bei {city.sonnenstunden} Sonnenstunden — {metrics.spezifischerErtrag > 950 ? 'überdurchschnittlich ertragsreich' : 'solide Erträge'} für {city.bundesland}.
      </p>
      
      <div id="solar-map" class="h-64 md:h-80 w-full rounded-xl border border-gray-200 shadow-inner z-10"></div>
      <p class="text-[11px] text-gray-400 text-center">
        Kartendaten © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow" class="underline">OpenStreetMap</a>-Mitwirkende.
      </p>

      <script is:inline define:vars={{ lat: city.lat, lng: city.lng, cityName: city.name, zip: city.zip, ertrag: metrics.spezifischerErtrag, nearby: nearbyCities.slice(0, 6).map(nc => ({ name: nc.name, lat: nc.lat, lng: nc.lng, zip: nc.zip, slug: nc.slug })) }}>
        document.addEventListener('DOMContentLoaded', () => {
          if (typeof L !== 'undefined' && document.getElementById('solar-map')) {
            const map = L.map('solar-map', { scrollWheelZoom: false }).setView([lat, lng], 10);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              attribution: '© OpenStreetMap'
            }).addTo(map);
            
            // Main city marker (orange)
            L.circleMarker([lat, lng], {
              radius: 12,
              fillColor: '#00BFA5',
              color: '#FFFFFF',
              weight: 3,
              opacity: 1,
              fillOpacity: 0.95
            }).addTo(map)
              .bindPopup(`<b>${cityName}</b><br>PLZ: ${zip}<br>Ertrag: ${ertrag} kWh/kWp`)
              .openPopup();

            // Nearby city markers (smaller, blue)
            nearby.forEach(nc => {
              L.circleMarker([nc.lat, nc.lng], {
                radius: 7,
                fillColor: '#283593',
                color: '#FFFFFF',
                weight: 2,
                opacity: 0.9,
                fillOpacity: 0.75
              }).addTo(map)
                .bindPopup(`<a href="/pv-anlage/${nc.slug}"><b>${nc.name}</b></a><br>PLZ: ${nc.zip}`);
            });
          }
        });
      </script>
    </section>

    <!-- Block 6: Regionale Markteinordnung — Nachbarschafts-Vergleich -->
    {nearbyComparisons.length > 0 && (
      <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
        <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">📈 Solarertrag-Vergleich: {city.name} vs. Nachbarstädte</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-200">
                <th class="text-left px-4 py-2.5 text-gray-600 font-semibold text-xs">Stadt</th>
                <th class="text-right px-4 py-2.5 text-gray-600 font-semibold text-xs">Sonnenstunden</th>
                <th class="text-right px-4 py-2.5 text-gray-600 font-semibold text-xs">Ertrag (kWh/kWp)</th>
                <th class="text-right px-4 py-2.5 text-gray-600 font-semibold text-xs">Differenz</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr class="bg-teal-50/50">
                <td class="px-4 py-2.5 font-semibold text-gray-900">📍 {city.name} (Ihr Standort)</td>
                <td class="px-4 py-2.5 text-right font-data font-bold text-gray-900">{city.sonnenstunden} h</td>
                <td class="px-4 py-2.5 text-right font-data font-bold text-teal-700">{metrics.spezifischerErtrag} kWh/kWp</td>
                <td class="px-4 py-2.5 text-right text-gray-400">—</td>
              </tr>
              {nearbyComparisons.map(nc => (
                <tr>
                  <td class="px-4 py-2.5"><a href={"/pv-anlage/" + nc.slug} class="text-accent-600 hover:text-accent-500 font-semibold">{nc.name}</a> <span class="text-gray-400 text-xs">({nc.zip})</span></td>
                  <td class="px-4 py-2.5 text-right font-data text-gray-700">{nc.sonnenstunden} h</td>
                  <td class="px-4 py-2.5 text-right font-data text-gray-700">{nc.ertrag} kWh/kWp</td>
                  <td class={`px-4 py-2.5 text-right font-data font-semibold ${nc.differenz.startsWith('+') ? 'text-green-600' : nc.differenz.startsWith('-') ? 'text-red-600' : 'text-gray-500'}`}>{nc.differenz}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-[11px] text-gray-400 mt-2">Spezifischer Ertrag berechnet auf Basis von Sonnenstunden, Globalstrahlung und regionaler Performance Ratio. Richtwerte ohne Gewähr.</p>
      </section>
    )}

    <!-- Block 7: Förderungen (with varied Bundesland data) -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">🏛️ Förderung & Steuervorteile in {city.bundesland}</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
          <h3 class="font-bold text-gray-900 text-sm">0% Umsatzsteuersatz</h3>
          <p class="text-xs text-gray-600 mt-2">Seit 2023 entfällt die Mehrwertsteuer auf PV-Anlagen und Speicher komplett — Sie sparen direkt 19% Anschaffungskosten (§ 12 Abs. 3 UStG).</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
          <h3 class="font-bold text-gray-900 text-sm">KfW-Förderkredit 270</h3>
          <p class="text-xs text-gray-600 mt-2">Die <a href="https://www.kfw.de/inlandsfoerderung/Privatpersonen/Bestehende-Immobilie/F%C3%B6rderprodukte/Erneuerbare-Energien-Standard-(270)/" target="_blank" rel="noopener nofollow" class="text-accent-600 hover:text-accent-500 underline font-semibold">KfW</a> bietet zinsgünstige Darlehen für Photovoltaik, Speicher und Zählerplatz-Modernisierung.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
          <h3 class="font-bold text-gray-900 text-sm">Landesprogramm {city.bundesland}</h3>
          <p class="text-xs text-gray-600 mt-2">Informieren Sie sich über aktuelle regionale Förderprogramme beim <a href={landLinks.foerderprogramm.url} target="_blank" rel="noopener nofollow" class="text-accent-600 hover:text-accent-500 underline font-semibold">{landLinks.foerderprogramm.label}</a>.</p>
        </div>
      </div>
      <div class="bg-blue-50 rounded-xl p-4 mt-4 border border-blue-100">
        <p class="text-xs text-blue-800" set:html={landLinks.solarpflichtInfo} />
      </div>
      <div class="text-center mt-4">
        <a href="/ratgeber/photovoltaik-foerderung-2026" class="text-accent-600 hover:text-accent-500 text-sm font-semibold transition-colors">
          Ausführlicher Ratgeber zur Solarförderung →
        </a>
      </div>
    </section>

    <!-- Block 8: Offizielle Anlaufstellen & nützliche Links (E-E-A-T) -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">🔗 Offizielle Anlaufstellen für {city.name}</h2>
      <p class="text-sm text-gray-600 mb-4">Weiterführende Links zu Behörden, Energieagenturen und unabhängigen Beratungsstellen für Ihre Photovoltaik-Planung:</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href={landLinks.solarkataster.url} target="_blank" rel="noopener nofollow" class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
          <span class="text-xl mt-0.5">🗺️</span>
          <div>
            <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-sm block">{landLinks.solarkataster.label}</span>
            <span class="text-xs text-gray-500 block mt-0.5">Solarpotenzial Ihres Daches kostenlos analysieren</span>
          </div>
        </a>
        <a href={landLinks.energieagentur.url} target="_blank" rel="noopener nofollow" class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
          <span class="text-xl mt-0.5">🏢</span>
          <div>
            <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-sm block">{landLinks.energieagentur.label}</span>
            <span class="text-xs text-gray-500 block mt-0.5">Kostenlose Beratung & Fördermittel-Infos</span>
          </div>
        </a>
        <a href={landLinks.verbraucherzentrale.url} target="_blank" rel="noopener nofollow" class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
          <span class="text-xl mt-0.5">🛡️</span>
          <div>
            <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-sm block">{landLinks.verbraucherzentrale.label}</span>
            <span class="text-xs text-gray-500 block mt-0.5">Unabhängige Energie-Checks ab 30 €</span>
          </div>
        </a>
        <a href={metrics.netzbetreiber.url} target="_blank" rel="noopener nofollow" class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
          <span class="text-xl mt-0.5">⚡</span>
          <div>
            <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-sm block">{metrics.netzbetreiber.name}</span>
            <span class="text-xs text-gray-500 block mt-0.5">Ihr Netzbetreiber — Anmeldung & Zählersetzung</span>
          </div>
        </a>
        {selectedFederalLinks.map(link => (
          <a href={link.url} target="_blank" rel="noopener nofollow" class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
            <span class="text-xl mt-0.5">{link.category === 'register' ? '📋' : link.category === 'foerderung' ? '💰' : link.category === 'forschung' ? '🔬' : link.category === 'verband' ? '🏛️' : link.category === 'beratung' ? '💬' : '⚖️'}</span>
            <div>
              <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-sm block">{link.label}</span>
              <span class="text-xs text-gray-500 block mt-0.5">{link.description.substring(0, 80)}…</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Block 9: FAQ locale (varied per city) -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">❓ Häufige Fragen zur Photovoltaik in {city.name}</h2>
      <div class="space-y-4">
        {content.faq.map(item => (
          <details class="group border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-5 py-4 bg-gray-50 hover:bg-gray-100 transition-colors font-semibold text-gray-900 text-sm">
              <span>{item.q}</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-5 py-4 text-sm text-gray-700 leading-relaxed border-t border-gray-100">
              <p set:html={item.a} />
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Block 10: Nearby cities -->
    {nearbyCities.length > 0 && (
      <section>
        <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">📍 Solaranbieter in der Nachbarschaft</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {nearbyCities.map((nc) => (
            <a href={"/pv-anlage/" + nc.slug} class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-accent-500 hover:shadow-md transition-all group text-center card-hover">
              <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-xs md:text-sm block">{nc.name}</span>
              <span class="text-xs text-gray-500">{nc.zip} · {nc.sonnenstunden} h</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Block 11: Guides recommandés -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">📚 Relevante Solar-Ratgeber</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="/ratgeber/solaranlage-kosten-2026" class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">💰</span>
          <span class="font-bold text-gray-900 group-hover:text-accent-600 text-sm block">Photovoltaik Kosten 2026</span>
          <span class="text-xs text-gray-600 mt-1 block">Brutto-Preise pro kWp und Speicher</span>
        </a>
        <a href="/ratgeber/photovoltaik-foerderung-2026" class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">🏛️</span>
          <span class="font-bold text-gray-900 group-hover:text-accent-600 text-sm block">Solar-Förderung im Überblick</span>
          <span class="text-xs text-gray-600 mt-1 block">KfW-Zuschuss und steuerliche Vorteile</span>
        </a>
        <a href="/ratgeber/solaranlage-mit-speicher" class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-accent-500 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">🔋</span>
          <span class="font-bold text-gray-900 group-hover:text-accent-600 text-sm block">Lohnt sich ein Stromspeicher?</span>
          <span class="text-xs text-gray-600 mt-1 block">Eigenverbrauch steigern und Kosten senken</span>
        </a>
      </div>
    </section>

    <!-- Block 12: Hersteller -->
    <section>
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">🏆 Führende Modulhersteller & Zubehör</h2>
      <div class="grid grid-cols-2 sm:grid-cols-6 gap-3">
        <a href="/hersteller/meyer-burger" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-accent-500 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-xs md:text-sm">Meyer Burger</span>
          <span class="block text-[10px] text-gray-500">🇨🇭 Schweiz/DE</span>
        </a>
        <a href="/hersteller/solarwatt" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-accent-500 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-xs md:text-sm">Solarwatt</span>
          <span class="block text-[10px] text-gray-500">🇩🇪 Deutschland</span>
        </a>
        <a href="/hersteller/sma-solar" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-accent-500 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-xs md:text-sm">SMA Solar</span>
          <span class="block text-[10px] text-gray-500">🇩🇪 Wechselrichter</span>
        </a>
        <a href="/hersteller/fronius" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-accent-500 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-xs md:text-sm">Fronius</span>
          <span class="block text-[10px] text-gray-500">🇦🇹 Österreich</span>
        </a>
        <a href="/hersteller/senec" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-accent-500 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-xs md:text-sm">Senec</span>
          <span class="block text-[10px] text-gray-500">🇩🇪 Stromspeicher</span>
        </a>
        <a href="/hersteller/jinkosolar" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-accent-500 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-accent-600 text-xs md:text-sm">JinkoSolar</span>
          <span class="block text-[10px] text-gray-500">🇨🇳 Weltmarktführer</span>
        </a>
      </div>
    </section>

    <!-- Block 13: Final CTA -->
    <section>
      <div class="cta-gradient rounded-2xl p-8 text-center text-white">
        <h2 class="text-xl md:text-2xl font-bold mb-3 font-heading">Solarangebote in {city.name} vergleichen</h2>
        <p class="text-teal-100 mb-5 text-xs md:text-sm">Vergleichen Sie kostenlose Angebote regionaler Fachbetriebe • 100% unverbindlich • {metrics.ersparnisProJahr.toLocaleString('de-DE')} € Ersparnis/Jahr möglich</p>
        <a href="/angebot" class="inline-block bg-white text-accent-600 font-bold px-8 py-3.5 rounded-xl hover:bg-gray-100 transition-colors shadow-lg text-sm md:text-base">
          ☀️ Angebote anfordern
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
